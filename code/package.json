{
  "name": "ai-engineer-roadmap-code",
  "version": "1.0.0",
  "private": true,
  "description": "Shared TypeScript scaffolding for the AI Engineer Roadmap lessons",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "openai": "^4.47.0",
    "@anthropic-ai/sdk": "^0.24.0",
    "zod": "^3.23.0",
    "eventsource-parser": "^1.1.0",
    "ioredis": "^5.4.0",
    "express": "^4.19.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsx": "^4.11.0",
    "@types/node": "^20.12.0",
    "@types/express": "^4.17.21",
    "vitest": "^1.6.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^7.10.0",
    "@typescript-eslint/eslint-plugin": "^7.10.0"
  }
}