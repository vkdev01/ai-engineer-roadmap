# Copy to .env and fill in what you use. Never commit .env.
# The lessons run without every key — missing keys only disable the providers you are not using.

# --- Model providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
COHERE_API_KEY=

# Default model ids. Provider model ids change often: check the provider's
# current model list before relying on these in anything real.
DEFAULT_CHAT_MODEL=
DEFAULT_CHEAP_MODEL=
DEFAULT_EMBEDDING_MODEL=
DEFAULT_RERANK_MODEL=

# --- Retrieval stores ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=
CHROMA_PERSIST_DIR=./data/chroma

# --- Backend ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/airoadmap
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me
API_RATE_LIMIT_PER_MINUTE=60

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
MLFLOW_TRACKING_URI=./mlruns

# --- Cost control ---
# Your own budget guardrails, used by the cost-tracking lessons.
MAX_TOKENS_PER_REQUEST=4096
MAX_USD_PER_DAY=5
